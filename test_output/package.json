{
  "name": "tradeledger-automation",
  "version": "1.0.0",
  "description": "Playwright automation framework for Trade Ledger",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:login": "npx playwright test login.spec.ts --headed",
    "test:task": "npx playwright test createTask.spec.ts --headed",
    "test:retry": "npx playwright test --retries=2",
    "test:debug": "npx playwright test --debug",
    "test:trace": "npx playwright test --trace on",
    "clean": "rm -rf test-results/ playwright-report/",
    "report": "npx playwright show-report",
    "screenshots": "open test-results || start test-results"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "tradeledger"
  ],
  "author": "Flemming Bengtsen",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@types/node": "^20.11.0",
    "dotenv": "^16.3.1",
    "typescript": "^5.3.3",
    "winston": "^3.11.0"
  }
}